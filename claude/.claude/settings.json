{
  "permissions": {
    "allow": [
      "Bash(echo:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/dotfiles/claude/.claude/hooks/block-secret-read.sh\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/dotfiles/claude/.claude/hooks/block-inline-secret-bash.sh\"" }
        ]
      }
    ]
  },
  "theme": "dark"
}
